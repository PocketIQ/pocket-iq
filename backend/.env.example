# --- AI ---
GEMINI_API_KEY=AIzaSy...your-key
# Model for the coach and for identifying balls in photos.
GEMINI_MODEL=gemini-flash-lite-latest
# Tried in order if GEMINI_MODEL is overloaded or takes over 25s.
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash
# "on" adds a slow Gemini second opinion on which number each ball is. Off by default:
# ball positions and types come from the fast OpenCV pipeline.
GEMINI_BALL_ID=off

# --- Vision ---
# "yolo" finds balls with the trained detector (models/balls.onnx, from
# tools/train_yolo.py); "circles" (default) uses the OpenCV circle search. If the model
# is missing or fails, it falls back to circles. Naming the balls is the same either way.
BALL_DETECTOR=circles
# YOLO_MODEL=models/balls.onnx

# --- Voice (ElevenLabs reads the coach's advice aloud) ---
ELEVENLABS_API_KEY=sk_...your-key
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Database (Tiger Data: Postgres + TimescaleDB) ---
# The service URL from the Tiger Cloud console (Connect -> "Service URL").
DATABASE_URL=postgres://tsdbadmin:your-password@your-service.tsdb.cloud.timescale.com:12345/tsdb?sslmode=require

# --- CORS ---
FRONTEND_ORIGINS=http://localhost:5173
